{
  "schema_version": 1,
  "template_id": "bcd_travel_india__invoice",
  "version": 1,
  "document_type": "invoice",
  "dayfirst": true,
  "date_formats": ["%d.%m.%Y", "%d/%m/%Y", "%d-%m-%Y", "%d %b %Y", "%Y-%m-%d"],
  "vendor": {
    "display_name": "BCD Travel India Pvt. Ltd.",
    "slug": "bcd_travel_india",
    "aliases": ["BCD Travel"],
    "identifiers": { "gstin": "09AAACF1613R1ZF" }
  },
  "fingerprint": {
    "required_tokens": ["BCD Travel", "TAX INVOICE"],
    "forbidden_tokens": [],
    "min_score": 0.72,
    "review_below": 0.85
  },
  "fields": [
    {
      "name": "vendor_name", "label": "Vendor Name", "data_type": "string",
      "required": true,
      "strategies": [{ "type": "constant", "value": "BCD Travel India Pvt. Ltd." }]
    },
    {
      "name": "vendor_gstin", "label": "Vendor GSTIN", "data_type": "string",
      "required": true,
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "GSTIN", "match": "contains", "occurrence": "first",
                    "search_scope": { "page": 1, "region_norm": [0.0, 0.0, 1.0, 0.20] } },
        "value_window": { "direction": "right", "max_distance_pt": 160 },
        "pattern": "[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]",
        "post": ["remove_spaces", "upper"]
      }],
      "validators": [{ "type": "checksum", "algorithm": "gstin" }]
    },
    {
      "name": "invoice_number", "label": "Invoice Number", "data_type": "string",
      "required": true, "unique_key": true,
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "Invoice no.", "match": "fuzzy", "occurrence": "first",
                    "search_scope": { "page": 1 } },
        "value_window": { "direction": "right", "max_distance_pt": 160 },
        "pattern": "[0-9]{5,12}",
        "post": ["strip"]
      }],
      "validators": [{ "type": "length", "min": 5, "max": 15 }]
    },
    {
      "name": "invoice_date", "label": "Invoice Date", "data_type": "date",
      "required": true,
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "Date", "match": "exact", "occurrence": "first",
                    "search_scope": { "page": 1,
                                      "region_norm": [0.5, 0.20, 1.0, 0.35] } },
        "value_window": { "direction": "right", "max_distance_pt": 140 },
        "pattern": "\\d{1,2}\\.\\d{1,2}\\.\\d{2,4}"
      }],
      "validators": [{ "type": "range", "min": "-5y", "max": "+1y" }]
    },
    {
      "name": "customer_name", "label": "Customer Name", "data_type": "string",
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "Ship To", "match": "fuzzy",
                    "search_scope": { "page": 1 } },
        "value_window": { "direction": "below", "max_distance_pt": 260,
                          "max_below_pt": 16,
                          "stop_at_anchor": ["Dossier"] },
        "pattern": "[A-Z][A-Z .&]{4,60}(?:LIMITED|LTD|LLP|PVT)?"
      }]
    },
    {
      "name": "customer_gstin", "label": "Customer GSTIN", "data_type": "string",
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "GSTIN", "match": "contains", "occurrence": "first",
                    "search_scope": { "page": 1,
                                      "region_norm": [0.0, 0.20, 1.0, 0.40] } },
        "value_window": { "direction": "right", "max_distance_pt": 160 },
        "pattern": "[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]",
        "post": ["remove_spaces", "upper"]
      }],
      "validators": [{ "type": "checksum", "algorithm": "gstin" }]
    },
    {
      "name": "total_taxable_amount", "label": "Total Taxable Amount",
      "data_type": "decimal",
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "Total Taxable amount", "match": "fuzzy",
                    "search_scope": { "page": "any" } },
        "value_window": { "direction": "right", "max_distance_pt": 160 },
        "pattern": "[\\d,]+\\.\\d{2}",
        "post": ["strip_currency", "strip"]
      }]
    },
    {
      "name": "total_gst_amount", "label": "Total GST Amount", "data_type": "decimal",
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "Total GST amount", "match": "exact",
                    "search_scope": { "page": "any" } },
        "value_window": { "direction": "right", "max_distance_pt": 160 },
        "pattern": "[\\d,]+\\.\\d{2}",
        "post": ["strip_currency", "strip"]
      }]
    },
    {
      "name": "grand_total", "label": "Total Amount", "data_type": "decimal",
      "required": true,
      "strategies": [{
        "type": "anchor_relative",
        "anchor": { "text": "Total amount", "match": "exact",
                    "search_scope": { "page": "any" } },
        "value_window": { "direction": "right", "max_distance_pt": 160 },
        "pattern": "[\\d,]+\\.\\d{2}",
        "post": ["strip_currency", "strip"]
      }],
      "validators": [{ "type": "range", "min": 0, "max": 100000000 }]
    }
  ],
  "tables": [],
  "cross_checks": [
    { "id": "taxable_plus_gst_equals_total",
      "expr": "abs(total_taxable_amount + total_gst_amount - grand_total) <= max(1.0, 0.01 * grand_total)",
      "on_fail": "review" }
  ],
  "output": {
    "sheet_group": "invoice",
    "column_order": ["invoice_number", "invoice_date", "customer_name",
                     "vendor_gstin", "customer_gstin", "total_taxable_amount",
                     "total_gst_amount", "grand_total"]
  }
}
